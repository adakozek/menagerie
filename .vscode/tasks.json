{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++ build",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "bird.cpp",
        "cat.cpp",
        "dog.cpp",
        "hazikedvenc_test.cpp",
        "rept.cpp",
        "pet.cpp",
        "menu.cpp",
        "memtrace.cpp",
        "file.cpp",
        "menageie.cpp",
        "string.cpp",
        "-o",
        "program.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}