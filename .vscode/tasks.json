{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++ build",
      "type": "shell",
      "command": "g++",
      "args": [
        "-std=c++17",
        "-g",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "*.cpp",
        "-o",
        "program.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}